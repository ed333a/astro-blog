---
import PageShell from "../layouts/PageShell.astro";
import GlassElement from "../components/glass/GlassElement.astro";
import { siteConfig } from "../objects/config";
import { getSortedPosts } from "../objects/collections";

// 文章按时间倒序, 再按年份分组 (dateText 是 YYYY-MM-DD; 没写日期的归入「未标注」)。
const posts = await getSortedPosts();

const yearMap = new Map<string, typeof posts>();
for (const post of posts) {
    const year = post.data.dateText?.slice(0, 4) ?? "未标注";
    const list = yearMap.get(year) ?? [];
    list.push(post);
    yearMap.set(year, list);
}
const years = [...yearMap.entries()];
---

<PageShell
    title="归档"
    description={`${siteConfig.title} 的文章归档, 共 ${posts.length} 篇文章。按年份和发布时间线浏览嵌入式开发、FPGA 与博客维护等全部内容。`}
    path="/archives"
    keywords={["文章归档", "技术博客", ...years.map(([year]) => (year === "未标注" ? "未标注日期" : `${year} 年`))]}
>
    <header class="flex flex-col gap-2 pt-4">
        <p class="m-0 text-xs font-semibold tracking-[0.25em] text-ink/80 uppercase text-shadow-contrast">Archives</p>
        <h1 class="m-0 text-3xl font-extrabold sm:text-4xl text-shadow-contrast">归档</h1>
        <p class="m-0 max-w-2xl text-sm text-ink/95 text-shadow-contrast">共 {posts.length} 篇文章。</p>
    </header>

    <GlassElement class="flex flex-col gap-6 rounded-[var(--radius-card)] p-6 text-ink sm:p-8">
        {years.length === 0
            ? <p class="m-0 text-sm text-ink/85">还没有文章。</p>
            : years.map(([year, yearPosts]) => (
                <section class="flex flex-col gap-3">
                    <div class="flex items-baseline gap-3">
                        <h2 class="m-0 text-xl font-bold">{year}</h2>
                        <span class="text-xs font-semibold text-ink/70">{yearPosts.length} 篇</span>
                    </div>
                    <ol class="m-0 flex list-none flex-col p-0">
                        {yearPosts.map((post) => (
                            <li class="relative flex gap-4 border-l border-ink/20 pb-5 pl-5 last:pb-0">
                                <span class="absolute top-1.5 -left-[5px] h-2.5 w-2.5 rounded-full border border-ink/40 bg-black/40 dark:bg-white/30" aria-hidden="true"></span>
                                <time datetime={post.data.dateText} class="shrink-0 font-mono text-xs leading-6 text-ink/60">{post.data.dateText}</time>
                                <a href={`/${post.data.path}`} class="min-w-0 truncate font-semibold leading-6 underline-offset-4 transition-opacity hover:underline hover:opacity-80">{post.data.title}</a>
                            </li>
                        ))}
                    </ol>
                </section>
            ))}
    </GlassElement>
</PageShell>
