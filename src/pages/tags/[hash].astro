---
import PageShell from "../../layouts/PageShell.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { siteConfig } from "../../objects/config";
import { getSortedPosts } from "../../objects/collections";
import { tagHash } from "../../objects/tags";

// 每个标签生成一个页面: /tags/<标签哈希>, 列出该标签下的全部文章。
// 路径用哈希而不是标签原文, 避免中文/符号直接出现在 URL 里。
export async function getStaticPaths() {
    const posts = await getSortedPosts();
    const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

    return tags.map((tag) => ({
        params: { hash: tagHash(tag) },
        props: {
            tag,
            tagPosts: posts.filter((post) => post.data.tags.includes(tag)),
        },
    }));
}

const { tag, tagPosts } = Astro.props;

// 标签 + 这些文章的分类, 一起作为页面关键词
const keywordList = [
    tag,
    "文章标签",
    ...tagPosts
        .map((post) => post.data.category)
        .filter((category): category is string => Boolean(category)),
];
---

<PageShell
    title={`标签: ${tag}`}
    description={`${siteConfig.title} 中标签「${tag}」下的全部文章, 共 ${tagPosts.length} 篇。包含相关主题的技术笔记与经验分享。`}
    path={`/tags/${tagHash(tag)}`}
    keywords={keywordList}
>
    <header slot="header" class="flex flex-col gap-2 pt-4">
        <p class="m-0 text-xs font-semibold tracking-[0.25em] text-ink/80 uppercase">Tag</p>
        <h1 class="m-0 text-3xl font-extrabold sm:text-4xl">#{tag}</h1>
        <p class="m-0 max-w-2xl text-sm text-ink/95">
            共 {tagPosts.length} 篇文章 ——
            <a href="/tags" class="font-semibold underline-offset-4 transition-opacity hover:underline hover:opacity-75">← 全部标签</a>
        </p>
    </header>

    <section class="flex flex-col gap-3" aria-label={`标签 ${tag} 的文章`}>
        {tagPosts.map((post) => <ArticleCard post={post} />)}
    </section>
</PageShell>