---
import GlassElement from "./glass/GlassElement.astro";
import ThemeToggleButton from "./ThemeToggleButton.astro";
import { Icon } from "astro-icon/components";
import { navLinks } from "../objects/navLinks";
---

<div
    data-nav-scrim
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 z-[60] bg-black/40 opacity-0 transition-opacity duration-300 ease-out nav-open:pointer-events-auto nav-open:opacity-100 md:hidden"
>
</div>

<GlassElement
    as="aside"
    id="nav-sidebar"
    data-nav-panel
    inert
    aria-hidden="true"
    aria-label="移动端导航菜单"
    class="fixed top-[5px] right-[5px] bottom-[5px] z-[70] flex w-[min(80vw,20rem)] translate-x-[calc(100%_+_12px)] flex-col gap-6 overflow-y-auto rounded-[var(--radius-card)] px-5 py-6 text-ink transition-[translate] duration-300 ease-out nav-open:translate-x-0 md:hidden"
>
    <div class="flex items-center justify-between">
        <p class="m-0 text-xs font-semibold tracking-[0.25em] text-ink/80 uppercase">菜单</p>

        <!-- 关闭按钮: 和展开按钮一样的小圆钮 (由 NavSidebar 的脚本认 [data-nav-close]) -->
        <button
            type="button"
            data-nav-close
            aria-label="关闭导航菜单"
            class="flex cursor-pointer items-center rounded-full bg-black/20 p-2 transition duration-300 ease-out hover:opacity-70 dark:bg-white/15"
        >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4 w-4" aria-hidden="true">
                <path d="M6 6l12 12M18 6 6 18"></path>
            </svg>
        </button>
    </div>

    <!-- flex-1 把主题按钮推到最下面; 链接占满整行, 手指点起来更稳 -->
    <nav class="flex-1">
        <ul class="m-0 flex list-none flex-col gap-1 p-0">
            {navLinks.map((link) => (
                <li>
                    <a
                        href={link.href}
                        {...(link.external ? { target: "_blank", rel: "noopener" } : {})}
                        {...(link.noSwup ? { "data-no-swup": "" } : {})}
                        class="flex items-center gap-2.5 rounded-2xl px-4 py-3 text-base font-semibold transition-colors duration-300 ease-out hover:bg-black/20 dark:hover:bg-white/15"
                    >
                        {link.icon && <Icon name={link.icon} class="h-4 w-4 shrink-0" aria-hidden="true" />}
                        <span>{link.label}</span>
                        {link.external && <span class="sr-only">(在新标签页打开)</span>}
                    </a>
                </li>
            ))}
        </ul>
    </nav>

    <ThemeToggleButton class="w-full justify-center px-4 py-3 text-sm" />
</GlassElement>

<!-- Swup 换页时会把文档里的内联脚本再执行一遍 (SwupScriptsPlugin), 而抽屉在 #swup-container 之外、
     事件本来就挂在 document 上 —— 重复绑定会让「开 → 关」瞬间互相抵消, 看起来就是点了没反应
     (所以只有没换过页的首页能打开)。下面用 <html data-nav-bound> 挡住后续执行。 -->
<script>
    const html = document.documentElement;
    const isNavOpen = () => html.dataset.nav === "open";

    const setNavOpen = (open: boolean) => {
        html.dataset.nav = open ? "open" : "closed";

        // 抽屉铺满右侧, 背后还能滚页面会很怪 —— 开着的时候锁住 body 滚动 (收起时把行内样式清掉)
        document.body.style.overflow = open ? "hidden" : "";

        document.querySelectorAll<HTMLElement>("[data-nav-toggle]").forEach((trigger) => {
            trigger.setAttribute("aria-expanded", String(open));
        });

        // 收起的抽屉只是「移出屏幕」而不是 display:none, 里面的链接照样会被 Tab 聚焦、被读屏念出来;
        // 用 inert + aria-hidden 把它彻底摘掉 (不认识 inert 的老浏览器会忽略这个属性, 不影响布局)。
        document.querySelectorAll<HTMLElement>("[data-nav-panel]").forEach((panel) => {
            panel.toggleAttribute("inert", !open);
            panel.setAttribute("aria-hidden", String(!open));
        });

        // 打开时顺手把焦点送进抽屉: 否则焦点还停在被遮罩盖住的按钮上, 键盘用户要 Tab 一圈才进得来
        if (open) document.querySelector<HTMLElement>("[data-nav-panel] [data-nav-close]")?.focus();
    };

    if (html.dataset.navBound !== "1") {
        html.dataset.navBound = "1";

        document.addEventListener("click", (event) => {
            const target = event.target as HTMLElement | null;
            if (!target) return;

            if (target.closest("[data-nav-toggle]")) setNavOpen(!isNavOpen());
            else if (target.closest("[data-nav-close]") || target.closest("[data-nav-scrim]")) setNavOpen(false);
            // 点了抽屉里的链接就该走了, 顺手收起抽屉 (主题按钮不是 <a>, 所以点它不会把抽屉关掉)
            else if (target.closest("[data-nav-panel] a")) setNavOpen(false);
        });

        // Esc 关掉 (跟对话框的习惯对齐)
        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && isNavOpen()) setNavOpen(false);
        });

        // 拉宽到 md (768px) 就是桌面布局了, 抽屉本就整块隐藏 —— 顺手复位状态,
        // 免得再缩回手机宽度时抽屉自己开着。
        window.matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
            if (event.matches) setNavOpen(false);
        });
    }
</script>