---
import GlassElement from "./glass/GlassElement.astro";
import NavSidebar from "./NavSidebar.astro";
import SearchBox from "./SearchBox.astro";
import ThemeToggleButton from "./ThemeToggleButton.astro";
import { Icon } from "astro-icon/components";
import { navLinks } from "../objects/navLinks";
---

<!-- 宽度跟着内容区走: 视口宽度减去两侧留白 (--page-gutter, 窄屏 2.5vw → 95%,
     桌面端 8.5vw → 83%), 于是导航栏永远和下面的卡片左右对齐。 -->
<GlassElement as="nav" class="fixed inset-x-0 top-[5px] z-50 mx-auto flex w-[calc(100%_-_2_*_var(--page-gutter))] items-center justify-between rounded-[var(--radius-navbar)] px-7 py-3.5 text-ink">
    <a href="/" class="shrink-0 whitespace-nowrap text-xl font-extrabold tracking-tight">硬件日记</a>

    <div class="flex items-center gap-3 md:gap-4 xl:gap-5">
        <SearchBox />

        <!-- 桌面端: 导航链接 + 主题切换 -->
        <div class="hidden items-center gap-4 md:flex xl:gap-5">
            <!-- 链接来自 config.yml 的 navBar.links (图标在文字左侧, Font Awesome 7)。
                 8 个条目 + 图标在 768px 宽度下也放得下, 靠的是字号随断点递进 (13 → 14 → 15px)
                 和图标尺寸同步放大 (12 → 14 → 16px); 间距只在 xl 才放开。 -->
            <ul class="m-0 flex list-none gap-2.5 p-0 xl:gap-5">
                {navLinks.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            {...(link.external ? { target: "_blank", rel: "noopener" } : {})}
                            {...(link.noSwup ? { "data-no-swup": "" } : {})}
                            class="flex items-center gap-1 text-[13px] font-semibold transition-opacity duration-300 ease-out hover:opacity-70 lg:text-sm xl:gap-1.5 xl:text-[15px]"
                        >
                            {link.icon && (
                                <Icon
                                    name={link.icon}
                                    class="h-3 w-3 shrink-0 lg:h-3.5 lg:w-3.5 xl:h-4 xl:w-4"
                                    aria-hidden="true"
                                />
                            )}
                            <span class="shrink-0 whitespace-nowrap">{link.label}</span>
                            {link.external && <span class="sr-only">(在新标签页打开)</span>}
                        </a>
                    </li>
                ))}
            </ul>

            <!-- 紧凑版主题按钮 (尺寸由调用处给, 见 ThemeToggleButton 的说明) -->
            <ThemeToggleButton class="px-3 py-1.5 text-[13px]" />
        </div>

        <!-- 移动端: 只留这个按钮。aria-controls 指向抽屉, aria-expanded 由 NavSidebar 的脚本维护 -->
        <button
            type="button"
            data-nav-toggle
            aria-controls="nav-sidebar"
            aria-expanded="false"
            aria-label="打开导航菜单"
            class="flex cursor-pointer items-center rounded-full bg-black/20 p-2.5 transition duration-300 ease-out hover:opacity-70 md:hidden dark:bg-white/15"
        >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4 w-4" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
        </button>
    </div>
</GlassElement>

<!-- 侧边栏 (抽屉) 跟着导航栏走: 用到 NavBar 的页面自动就有, 页面里不用再单独放一个 -->
<NavSidebar />


