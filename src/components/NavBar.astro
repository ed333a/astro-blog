---
import GlassElement from "./glass/GlassElement.astro";
import NavSidebar from "./NavSidebar.astro";
import SearchBox from "./SearchBox.astro";
import ThemeToggleButton from "./ThemeToggleButton.astro";
import { navLinks } from "../objects/navLinks";
---

<GlassElement as="nav" class="fixed inset-x-0 top-[5px] z-50 mx-auto flex w-[83%] items-center justify-between rounded-[var(--radius-navbar)] px-7 py-3.5 text-ink">
    <a href="/" class="text-xl font-extrabold tracking-tight">My Blog</a>

    <div class="flex items-center gap-3 md:gap-4 xl:gap-5">
        <SearchBox />

        <!-- 桌面端: 导航链接 + 主题切换 -->
        <div class="hidden items-center gap-4 md:flex xl:gap-5">
            <ul class="m-0 flex list-none gap-4 p-0 xl:gap-6">
                {navLinks.map((link) => (
                    <li><a href={link.href} class="text-[15px] font-semibold transition-opacity hover:opacity-70">{link.label}</a></li>
                ))}
            </ul>

            <!-- 紧凑版主题按钮 (尺寸由调用处给, 见 ThemeToggleButton 的说明) -->
            <ThemeToggleButton class="px-3 py-1.5 text-[13px]" />
        </div>

        <!-- 移动端: 只留这个按钮。aria-controls 指向抽屉, aria-expanded 由 NavSidebar 的脚本维护 -->
        <button
            type="button"
            data-nav-toggle
            aria-controls="nav-sidebar"
            aria-expanded="false"
            aria-label="打开导航菜单"
            class="flex cursor-pointer items-center rounded-full bg-black/20 p-2.5 transition duration-300 ease-out hover:opacity-70 md:hidden dark:bg-white/15"
        >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4 w-4" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
        </button>
    </div>
</GlassElement>

<!-- 侧边栏 (抽屉) 跟着导航栏走: 用到 NavBar 的页面自动就有, 页面里不用再单独放一个 -->
<NavSidebar />


