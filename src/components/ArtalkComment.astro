---
import '@/styles/artalk.css'
import { externalLinksConfig, siteConfig } from '@/objects/config';

const proxyPath = '/go';
const siteHost = (() => { try { return new URL(siteConfig.siteUrl).hostname.toLowerCase(); } catch { return ''; } })();
const trustedDomains = [...externalLinksConfig.trustedDomains.map((d) => d.trim().toLowerCase()).filter(Boolean), siteHost].filter(Boolean);
const proxyConfigJson = JSON.stringify({ path: proxyPath, enabled: externalLinksConfig.enable, trusted: trustedDomains });
---

<div id="comments" data-proxy-config={proxyConfigJson}></div>

<script>
    import Artalk from 'artalk';
    import { commentsConfig } from '@/objects/config';

    let serverUrl = import.meta.env.DEV ? commentsConfig.artalk.serverDev : commentsConfig.artalk.server;
    if (import.meta.env.DEV) {
        // 浏览器控制台输出
        console.log(`评论区: 在 DEV 模式下预览的 Artalk 评论系统, 后端地址: ${serverUrl};`);
    }

    let artalk: Artalk | null;
    let observer: MutationObserver;
    let retryCnt = 0;

    async function init() {
        // 等待DOM更新完成
        await new Promise(resolve => requestAnimationFrame(resolve));
        await new Promise(resolve => setTimeout(resolve, 0));

        const ele = document.getElementById("comments");
        if (!ele) {
            if (retryCnt < 10) {
                console.warn('comments element not found, retrying...');
                // 如果元素不存在，稍后重新初始化
                setTimeout(() => init(), 50);
                retryCnt++;
                return;
            } else {
                // 尝试初始化评论区的次数达到最大，直接返回。
                console.error('comments element load failed.');
                return;
            }
        }

        if (artalk && artalk.getEl() === ele) {
            console.log('Artalk already initialized');
            return;
        }

        if (artalk) {
            artalk.destroy();
            artalk = null;
        }

        try {
            artalk = Artalk.init({
            el: ele,
            pageKey: location.pathname,
            server: serverUrl,
            site: commentsConfig.artalk.site,
            darkMode: false,
            avatarURLBuilder: (comment) => {
                    // console.log(JSON.stringify(comment, null,2));
                    return `https://weavatar.com/avatar/${comment.email_encrypted}?d=initials&name=${comment.nick}`;
                },
            });

            bindThemeObserver();

            const isDark = document.documentElement.classList.contains('Dark');
            artalk.setDarkMode(isDark);

            console.log('Artalk initialized successfully.');
        } catch (error) {
            console.error('Failed to initialize Artalk: ', error);
        }
    }

    function bindThemeObserver() {
        if (observer) observer.disconnect();

        observer = new MutationObserver(() => {
            if (!artalk) return;
            const isDark = document.documentElement.classList.contains('Dark');
            console.log(`isDark: ${isDark}`)
            artalk.setDarkMode(isDark);
        });

        observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['class'],
        });
    }

    // -----------------------
    // 页面加载 & 导航事件
    // -----------------------
    let isInitializing = false;
    function safeInit() {
        if (isInitializing) return;
        isInitializing = true;

        // 不初始化首页
        if (location.pathname === '/' || location.pathname === 'index.html') {
            isInitializing = false;
            return;
        }

        init().finally(() => {
            setTimeout(() => {
                isInitializing = false;
            }, 300);
        });
    }

    const initEvents = ['DOMContentLoaded', 'astro:after-swap', 'pjax:complete', 'swup:contentReplaced']
    for (const e of initEvents) {
        document.addEventListener(e, () => {
            Promise.resolve().then(safeInit);
        })
    }

    // 初始加载
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => safeInit());
    } else {
        safeInit();
    }

    // 监听 Astro 页面切换完成
    document.addEventListener('astro:page-load', () => {
        safeInit();
    });

    window.addEventListener("beforeunload", () => {
        if (artalk) artalk.destroy();
        if (observer) observer.disconnect();
    });
</script>

<script is:inline>
    // Artalk 评论里的外链是客户端渲染的, 服务端改不了 —— 这里兜底: 点击时转到 /go 中转页。
    // 只处理 #comments 里的链接 (文章正文等其它外链已在渲染阶段改写完毕)。
    (() => {
        if (document.documentElement.dataset.commentProxyBound === "1") return;
        document.documentElement.dataset.commentProxyBound = "1";

        const readConfig = () => {
            const el = document.getElementById("comments");
            if (!el) return null;
            try { return JSON.parse(el.getAttribute("data-proxy-config") || ""); } catch { return null; }
        };
        const cfg = readConfig();
        if (!cfg || !cfg.enabled) return;

        const hostOf = (url) => { try { return new URL(url, location.origin).hostname.toLowerCase(); } catch { return ""; } };
        const isTrusted = (host) => (cfg.trusted || []).some((p) => {
            if (p === host) return true;
            if (p.startsWith("*.") || p.startsWith(".")) {
                const base = p.replace(/^\*\./, "");
                return host === base || host.endsWith("." + base);
            }
            return false;
        });

        document.addEventListener("click", (event) => {
            const anchor = event.target && event.target.closest ? event.target.closest("a[href]") : null;
            if (!anchor) return;
            const comments = document.getElementById("comments");
            if (!comments || !comments.contains(anchor)) return;
            const href = anchor.getAttribute("href") || "";
            if (!/^https?:\/\//i.test(href)) return;
            if (isTrusted(hostOf(href))) return;
            event.preventDefault();
            event.stopPropagation();
            window.location.href = `${cfg.path}?url=${encodeURIComponent(href)}`;
        }, true);
    })();
</script>
