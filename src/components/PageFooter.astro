---
import GlassElement from "./glass/GlassElement.astro";
import LicenseNotice from "./LicenseNotice.astro";
import { siteConfig } from "../objects/config";

interface Props {
    /** 当前页面的标题与路径: 有的话, 页脚里的版权信息会点名这一篇 */
    title?: string;
    path? : string;
}

const { title, path } = Astro.props;
const year = new Date().getFullYear();
---

<!-- 窄屏页脚用 32px 圆角 (全宽面板用胶囊圆角会显得头重脚轻), 到 md 再回到 config.yml 的 --radius-footer。 -->
<GlassElement as="footer" class="mt-auto flex flex-col items-center gap-3 rounded-[32px] px-8 py-6 text-sm text-ink sm:flex-row sm:items-start sm:justify-between sm:text-left md:rounded-[var(--radius-footer)]">
    <div class="flex flex-col items-center gap-1.5 sm:items-start">
        <p class="m-0 text-ink/85">© {year} {siteConfig.title} · {siteConfig.subtitle}</p>
        <LicenseNotice title={title} path={path} compact />
    </div>

    <ul class="m-0 flex list-none flex-wrap justify-center gap-6 p-0 font-semibold">
        <li><a href="/rss" class="transition-opacity hover:opacity-70">RSS</a></li>
        <li><a href="/blog" class="transition-opacity hover:opacity-70">归档</a></li>
        <li><a href="/about" class="transition-opacity hover:opacity-70">关于</a></li>
    </ul>
</GlassElement>

