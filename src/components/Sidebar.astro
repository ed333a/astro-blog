---
import GlassElement from "./glass/GlassElement.astro";
import { authorConfig } from "../objects/config";
import { getSortedPosts } from "../objects/collections";
import { getAsset } from "@/objects/getAssetUrl";

// 本地统计照常构建时计算
const posts = await getSortedPosts();
const articleCount = posts.length;
const totalWords = posts.reduce((sum, post) => sum + post.data.wordCount, 0);
const tagCount = new Set(posts.flatMap((post) => post.data.tags)).size;

const { name, avatar, bio, socialLinks } = authorConfig;

// value 为 null 的项由前端脚本异步填充
const stats = [
    { key: "articles",   label: "文章",     value: articleCount },
    { key: "words",      label: "字数",     value: totalWords },
    { key: "tags",       label: "标签",     value: tagCount },
    { key: "comments",   label: "评论",     value: null },
    { key: "total_pv",   label: "总访问量", value: null },
    { key: "total_uv",   label: "访客",     value: null },
];

const linkTarget = (url: string) =>
    url.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<!-- 右侧边栏: 作者信息 + 社交链接 + 站点统计。
     窄屏时它是「正文下方」的全宽面板, 桌面端 (lg) 才固定到右侧。
     sticky 定位已上移到 PageShell 的右栏容器 (侧边栏与目录一起停在导航栏下方)。 -->
<aside class="w-full">
    <GlassElement class="flex flex-col gap-5 rounded-[var(--radius-card)] p-5 text-ink">
        <!-- 作者: 头像 (没配置就显示名字首字母) + 名称 + 简介 -->
        <div class="flex items-center gap-3">
            {avatar
                ? <img src={getAsset(avatar)} alt={name} class="h-12 w-12 rounded-full object-cover" />
                : <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-black/20 text-lg font-bold dark:bg-white/15">{name.trim().charAt(0).toUpperCase()}</span>}
            <div class="flex min-w-0 flex-col gap-0.5">
                <p class="m-0 truncate text-base font-bold">{name}</p>
                {bio && <p class="m-0 truncate text-xs leading-relaxed text-ink/80">{bio}</p>}
            </div>
        </div>

        <!-- 社交链接 -->
        {socialLinks.length > 0 && (
            <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
                {socialLinks.map((link) => (
                    <li>
                        <a
                            href={link.url}
                            class="inline-flex items-center gap-1.5 rounded-full bg-black/20 px-3 py-1 text-xs font-semibold transition duration-300 ease-out hover:opacity-70 dark:bg-white/15"
                            {...linkTarget(link.url)}
                        >
                            {link.name}
                        </a>
                    </li>
                ))}
            </ul>
        )}

        <!-- 统计: 2 列小卡片, 数字在上、标签在下 -->
        <dl class="m-0 grid grid-cols-2 gap-2">
            {stats.map((stat) => (
                <div class="flex flex-col rounded-2xl bg-black/10 px-3 py-2 dark:bg-white/5">
                    <dt class="order-2 text-[11px] font-medium text-ink/70">{stat.label}</dt>
                    <dd
                        class="order-1 m-0 text-sm font-bold tabular-nums"
                        data-stat={stat.key}
                    >
                        {stat.value === null ? "—" : stat.value.toLocaleString("zh-CN")}
                    </dd>
                </div>
            ))}
        </dl>
    </GlassElement>
</aside>

<script>
    const CACHE_TTL = 60 * 60 * 1000; // 1 小时
    const CACHE_KEY = "sidebar-stats-cache-v1"; // 带版本号，格式变化时改 v2 即可失效

    const BLOG_STATS_API = "https://api.tyh123.top/blog_statistics.php";
    const ARTALK_COMMENT_API =
        "http://artalk.tyh123.top/api/v2/stats/site_comment";

    const fmt = (n) =>
        typeof n === "number" && Number.isFinite(n) ? n.toLocaleString("zh-CN") : "—";

    function setStat(key, value) {
        const el = document.querySelector(`[data-stat="${key}"]`);
        if (el) el.textContent = fmt(value);
    }

    // ---------- 缓存读写 ----------
    function readCache() {
        try {
            const raw = sessionStorage.getItem(CACHE_KEY);
            if (!raw) return {};
            const obj = JSON.parse(raw);
            return obj && typeof obj === "object" ? obj : {};
        } catch {
            return {};
        }
    }

    // 按字段各自打时间戳，避免一个接口失败拖累另一个的缓存
    function writeCache(patch) {
        try {
            const now = Date.now();
            const cache = readCache();
            for (const [k, v] of Object.entries(patch)) {
                cache[k] = { value: v, ts: now };
            }
            sessionStorage.setItem(CACHE_KEY, JSON.stringify(cache));
        } catch {
            /* 隐私模式等情况下静默失败 */
        }
    }

    // 未过期则返回缓存值，否则返回 undefined
    function getFresh(key) {
        const entry = readCache()[key];
        if (
            entry &&
            typeof entry.ts === "number" &&
            Date.now() - entry.ts < CACHE_TTL
        ) {
            return entry.value;
        }
        return undefined;
    }

    // ---------- 主流程 ----------
    function loadStats() {
        const cachedPv = getFresh("total_pv");
        const cachedUv = getFresh("total_uv");
        const cachedComments = getFresh("comments");

        // 命中缓存的立即上屏（不发请求）
        if (cachedPv !== undefined) setStat("total_pv", cachedPv);
        if (cachedUv !== undefined) setStat("total_uv", cachedUv);
        if (cachedComments !== undefined) setStat("comments", cachedComments);

        const needBlog = cachedPv === undefined || cachedUv === undefined;
        const needComments = cachedComments === undefined;

        if (needBlog) {
            fetch(BLOG_STATS_API)
                .then((r) => (r.ok ? r.json() : null))
                .then((d) => {
                    if (!d) return;
                    setStat("total_pv", d.total_pv);
                    setStat("total_uv", d.total_uv);
                    writeCache({ total_pv: d.total_pv, total_uv: d.total_uv });
                })
                .catch(() => {});
        }

        if (needComments) {
            fetch(ARTALK_COMMENT_API)
                .then((r) => (r.ok ? r.json() : null))
                .then((d) => {
                    if (!d || d.data == null) return;
                    setStat("comments", d.data);
                    writeCache({ comments: d.data });
                })
                .catch(() => {});
        }
    }

    if (document.readyState === "complete") {
        loadStats();
    } else {
        window.addEventListener("load", loadStats, { once: true });
    }

    // 每次加载页面都要执行一次
    document.addEventListener("astro:page-load", loadStats);
</script>
