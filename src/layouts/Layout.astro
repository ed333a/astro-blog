---
import '../styles/global.css';
import { authorConfig, cardSpotlightConfig, frostedGlassConfig, siteConfig, themeConfig } from '../objects/config';
import { absoluteSiteUrl, metaDescription, normalizeSitePath, siteOrigin, type SeoOptions } from '../objects/seo';

interface Props extends SeoOptions {
    /** 页面标题: 不传就用「站点标题 · 副标题」 */
    title?: string;
    /** 页面描述 (默认取 config.yml 的 siteConfig.description) */
    description?: string;
}

const {
    title,
    description,
    path,
    type = 'website',
    image,
    keywords = [],
    publishedTime,
    modifiedTime,
    section,
    noindex = false,
    prevPath,
    nextPath,
} = Astro.props;

const pageTitle = title ? `${title} · ${siteConfig.title}` : `${siteConfig.title} · ${siteConfig.subtitle}`;
// meta description 控制在 160 字以内; JSON-LD / Open Graph 里仍用完整描述
const fullDescription = description || siteConfig.description;
const pageDescription = metaDescription(fullDescription, siteConfig.description);

// canonical / og:url: 优先用页面显式传入的 path, 没传就取当前构建的路径
const canonicalUrl = absoluteSiteUrl(normalizeSitePath(path ?? Astro.url.pathname));
const ogImage = image ? absoluteSiteUrl(image) : undefined;
const prevUrl = prevPath ? absoluteSiteUrl(prevPath) : undefined;
const nextUrl = nextPath ? absoluteSiteUrl(nextPath) : undefined;

// 关键词: 去重 + 去掉空串, 同时输出成 meta keywords 与 article:tag
const keywordList = [...new Set(keywords.map((keyword) => keyword.trim()).filter(Boolean))];
const keywordContent = keywordList.join(', ');

const publishedIso = publishedTime?.toISOString();
const modifiedIso = (modifiedTime ?? publishedTime)?.toISOString();

// 结构化数据: WebSite + Organization + Person 是全站通用的身份信息, 文章页再补一条 BlogPosting。
// 用 @graph 包在一起, 页面只需要一个 JSON-LD 脚本; 结尾把 "<" 转义, 避免正文出现 </script>。
const authorSameAs = authorConfig.socialLinks
    .map((link) => link.url)
    .filter((url) => /^https?:\/\//i.test(url));

const jsonLd = JSON.stringify({
    '@context': 'https://schema.org',
    '@graph'  : [
        {
            '@type'      : 'WebSite',
            '@id'        : `${siteOrigin}/#website`,
            name         : siteConfig.title,
            alternateName: siteConfig.subtitle,
            url          : `${siteOrigin}/`,
            description  : siteConfig.description,
            inLanguage   : 'zh-CN',
            publisher    : { '@id': `${siteOrigin}/#organization` },
        },
        {
            '@type'      : 'Organization',
            '@id'        : `${siteOrigin}/#organization`,
            name         : siteConfig.title,
            url          : `${siteOrigin}/`,
            description  : siteConfig.description,
        },
        {
            '@type'      : 'Person',
            '@id'        : `${siteOrigin}/#person`,
            name         : authorConfig.name,
            description  : authorConfig.bio,
            url          : siteOrigin,
            ...(authorSameAs.length > 0 ? { sameAs: authorSameAs } : {}),
        },
        ...(type === 'article'
            ? [{
                '@type'          : 'BlogPosting',
                '@id'            : `${canonicalUrl}#article`,
                headline         : title ?? pageTitle,
                name             : title ?? pageTitle,
                description      : fullDescription,
                url              : canonicalUrl,
                mainEntityOfPage : { '@type': 'WebPage', '@id': canonicalUrl },
                inLanguage       : 'zh-CN',
                datePublished    : publishedIso,
                dateModified     : modifiedIso,
                articleSection   : section,
                keywords         : keywordContent || undefined,
                author           : { '@id': `${siteOrigin}/#person` },
                publisher        : { '@id': `${siteOrigin}/#organization` },
                isPartOf         : { '@id': `${siteOrigin}/#website` },
            }]
            : []),
    ],
}).replace(/</g, '\\u003c');

// 主题「模式」(Light/Dark/Auto) 来自 config.yml 的 theme.style。
// Dark 的情况服务端就能定下来, 先给 <html> 加上 Dark 类; Auto 要等浏览器解析系统偏好,
// 由下面 <head> 里的内联脚本在首帧之前补齐 (否则会闪一下错误的配色)。
const htmlClass = ['h-full', themeConfig.style === 'Dark' && 'Dark'];

// config.yml 的 frostedGlassStyle / cardSpotlight 全部在服务端渲染成 <html> 上的 CSS 自定义属性:
//   --glass-*      毛玻璃: backdrop-filter 的模糊/饱和度/亮度, 玻璃底色、描边、投影与页面兜底底色
//   --radius-*     圆角: 导航栏 / 页脚 / 卡片各一个, 互不影响
//   --spotlight-*  卡片光斑: 悬停时跟随鼠标的那圈描边的半径与颜色
// 日/夜各给一份 (-light / -dark), 由 global.css 按当前主题挑一个 —— 内联样式没法被类选择器覆盖,
// 所以不能只写一个值; 好处是切换主题完全不需要脚本参与。
const themeVars = [
    `--glass-blur:${frostedGlassConfig.blur}px`,
    `--glass-saturate:${frostedGlassConfig.saturate}`,
    `--glass-brightness-light:${frostedGlassConfig.brightnessLight}`,
    `--glass-brightness-dark:${frostedGlassConfig.brightnessDark}`,
    `--glass-bg-light:${frostedGlassConfig.background.light}`,
    `--glass-bg-dark:${frostedGlassConfig.background.dark}`,
    `--glass-border-light:${frostedGlassConfig.border.light}`,
    `--glass-border-dark:${frostedGlassConfig.border.dark}`,
    `--glass-shadow-light:${frostedGlassConfig.shadow.light}`,
    `--glass-shadow-dark:${frostedGlassConfig.shadow.dark}`,
    `--glass-page-light:${frostedGlassConfig.page.light}`,
    `--glass-page-dark:${frostedGlassConfig.page.dark}`,
    `--radius-navbar:${frostedGlassConfig.radius.navbar}px`,
    `--radius-footer:${frostedGlassConfig.radius.footer}px`,
    `--radius-card:${frostedGlassConfig.radius.card}px`,
    `--radius-code-block:${frostedGlassConfig.radius.codeBlock}px`,
    `--spotlight-radius:${cardSpotlightConfig.radius}px`,
    `--spotlight-color-light:${cardSpotlightConfig.color.light}`,
    `--spotlight-color-dark:${cardSpotlightConfig.color.dark}`,
].join(';');
---

<!doctype html>
<html
    lang="zh-CN"
    class:list={htmlClass}
    data-theme={themeConfig.style}
    style={themeVars}
>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />

        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />
        {keywordContent && <meta name="keywords" content={keywordContent} />}
        <meta name="author" content={authorConfig.name} />
        <meta
            name="robots"
            content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
        />
        <link rel="canonical" href={canonicalUrl} />
        {prevUrl && <link rel="prev" href={prevUrl} />}
        {nextUrl && <link rel="next" href={nextUrl} />}
        <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

        <!-- Open Graph (分享到社交平台 / IM 时的标题、描述与封面) -->
        <meta property="og:type" content={type} />
        <meta property="og:site_name" content={siteConfig.title} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:locale" content="zh_CN" />
        {ogImage && <meta property="og:image" content={ogImage} />}
        {ogImage && <meta property="og:image:alt" content={title ?? pageTitle} />}
        {type === 'article' && publishedIso && <meta property="article:published_time" content={publishedIso} />}
        {type === 'article' && modifiedIso && <meta property="article:modified_time" content={modifiedIso} />}
        {type === 'article' && section && <meta property="article:section" content={section} />}
        {type === 'article' && keywordList.map((keyword) => <meta property="article:tag" content={keyword} />)}

        <!-- Twitter Card -->
        <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription} />
        {ogImage && <meta name="twitter:image" content={ogImage} />}

        <!-- 结构化数据: 站点 / 作者身份 + 文章信息 (JSON-LD) -->
        <script type="application/ld+json" set:html={jsonLd} />
        <script is:inline>
            (() => {
                const root = document.documentElement;
                let mode = root.dataset.theme || "Auto";
                try {
                    mode = localStorage.getItem("theme") || mode;
                    localStorage.setItem("theme", mode);
                } catch {}
                const isDark = mode === "Dark"
                    || (mode === "Auto" && window.matchMedia("(prefers-color-scheme: dark)").matches);
                root.classList.toggle("Dark", isDark);
                root.dataset.theme = mode;
            })();
        </script>

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href="/rss.xml" />
        <meta name="generator" content={Astro.generator} />
        <link rel="stylesheet" href="/fonts.css" />
        <!-- umami 统计跟踪代码 -->
		{
			import.meta.env.PROD &&
			<script defer src="https://statistics.tyh123.top/script.js" data-website-id="cb9bb307-c9e3-4983-a3d9-7216220afea5"></script>
		}

		{
			import.meta.env.DEV && console.log("Dev 模式预览页面中，将不会加载统计跟踪脚本。")
		}
		<!-- umami 统计跟踪代码结束 -->
    </head>
    <body class="min-h-full font-sans text-ink antialiased">
        <slot />
    </body>
</html>

<!-- 主题按钮的点击 / 系统深浅色监听只该挂一次: Swup 换页会把这份脚本再执行一遍,
     重复绑定会让点一下连跳两个模式 (Light → Auto)。 -->
<script>
    import { BlogTheme, theme as applyTheme } from '../objects/utils';

    const THEME_MODES: BlogTheme[] = [BlogTheme.Light, BlogTheme.Dark, BlogTheme.Auto];
    const html = document.documentElement;

    /** 当前主题「模式」。首帧前的内联脚本已经把它写在 <html data-theme> 上 */
    const currentMode = (): BlogTheme => (html.dataset.theme as BlogTheme) || BlogTheme.Auto;

    /** 切换主题: 模式 (data-theme 决定按钮的图标/文案) + 外观 (Dark 类驱动全站配色与玻璃变量) */
    const setTheme = (mode: BlogTheme) => {
        applyTheme(mode);
        html.dataset.theme = mode;
    };

    /** 亮色 → 暗色 → 自动 → 亮色 */
    const nextMode = (): BlogTheme => {
        const index = THEME_MODES.indexOf(currentMode());
        return THEME_MODES[(index + 1) % THEME_MODES.length];
    };

    if (html.dataset.themeBound !== '1') {
        html.dataset.themeBound = '1';

        // 事件委托: 任何页面上的 [data-theme-toggle] 都能用
        document.addEventListener('click', (event) => {
            const trigger = (event.target as HTMLElement | null)?.closest('[data-theme-toggle]');
            if (trigger) setTheme(nextMode());
        });

        // Auto 模式下跟随系统深浅色变化
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
            if (currentMode() === BlogTheme.Auto) setTheme(BlogTheme.Auto);
        });
    }
</script>
