---
/**
 * 页面外壳: 所有前台页面共用的那一层 —— 背景图 + 顶部导航 + 内容 + 页脚。
 * 抽出来的目的是让每个页面只关心自己的内容, 顺便保证「背景 + 毛玻璃面板」这套视觉处处一致。
 *
 * 注意: 这层只是布局, 不参与毛玻璃本身 —— 玻璃的底色 / 模糊 / 圆角仍然全部来自
 * config.yml 的 frostedGlassStyle (由 Layout 写成 --glass-* 变量)。
 */
import Layout from "./Layout.astro";
import NavBar from "../components/NavBar.astro";
import PageFooter from "../components/PageFooter.astro";
import CodeBlockTools from "../components/CodeBlockTools.astro";
import Sidebar from "../components/Sidebar.astro";
import BackToTop from "../components/BackToTop.astro";
import BodyBackground from "../components/BodyBackground.astro";

interface Props {
    /** 浏览器标题 (Layout 会拼上站点名) */
    title?: string;
    description?: string;
    /** 当前文章 / 页面的标题与路径: 页脚里的版权信息会用到 */
    licenseTitle?: string;
    licensePath?: string;
}

const { title, description, licenseTitle, licensePath } = Astro.props;
---

<Layout title={title} description={description}>
    <div class="relative flex min-h-screen flex-col gap-6 px-[var(--page-gutter)] pt-24 pb-6">
        <BodyBackground />
        <NavBar />

        <div id="swup-container" class="flex flex-1 flex-col gap-6 transition-swup-fade">
            <slot name="header" />
            <div class="flex flex-col gap-6 lg:flex-row lg:items-stretch">
                <main class="flex min-w-0 flex-1 flex-col gap-6">
                    <slot />
                </main>
                <aside class="w-full lg:w-72 lg:shrink-0">
                    <!-- sticky 列限高: 让目录 (slot="sidebar") 在视口内收住, 超高部分交给它的内部滚动条。
                         7.5rem = sticky 顶部偏移 (top-24 = 6rem) + 底部留白 (1.5rem)。 -->
                    <div class="flex flex-col gap-6 lg:sticky lg:top-24 lg:max-h-[calc(100vh-7.5rem)]">
                        <Sidebar />
                        <slot name="sidebar" />
                    </div>
                </aside>
            </div>

            <PageFooter title={licenseTitle} path={licensePath} />
        </div>
        <CodeBlockTools />
        <BackToTop />
    </div>
</Layout>
